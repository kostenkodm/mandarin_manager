#!/bin/sh
# rpcd exec plugin. All backend methods require LuCI-authenticated ubus ACL.
BIN=/usr/bin/mandarin-vpn
case "$1" in
    list)
        cat <<'JSON'
{
  "status":{},
  "upgrade":{},
  "guest_diagnose":{},
  "peers":{"interface":""},
  "add_guest":{"name":""},
  "add_home":{"name":""},
  "disable_guest":{"name":""},
  "enable_guest":{"name":""},
  "delete_guest":{"name":""},
  "guest_profile":{"name":""},
  "managed_profile":{"interface":"","name":""},
  "migrate_prepare":{"interface":"","section":"","name":""},
  "migrate_finish":{"interface":"","name":""},
  "migrate_cancel":{"interface":"","name":""}
}
JSON
        ;;
    call)
        method=$2
        input=$(cat)
        case "$method" in
          status) "$BIN" status || true ;;
          upgrade)
              # Always return structured JSON, even when a child updater exits
              # unexpectedly before producing a response.
              result="$(MANDARIN_UPDATE_RPC=1 /usr/bin/mandarin-manager-update 2>/tmp/mandarin-manager-upgrade-error.log)" || code=$?
              if [ -n "$result" ] && printf '%s' "$result" | jq -e 'type == "object" and has("ok")' >/dev/null 2>&1; then
                  printf '%s\n' "$result"
              else
                  details="$(tail -n 4 /tmp/mandarin-manager-upgrade-error.log 2>/dev/null | tr '\n' ' ' | cut -c 1-240)"
                  [ -n "$details" ] || details="Updater exited without valid JSON (code ${code:-0}). Run mandarin-manager-update over SSH to see diagnostics."
                  jq -nc --arg error "$details" '{ok:false,error:$error}'
              fi
              ;;
          guest_diagnose) /usr/bin/mandarin-vpn-guest-diagnose 2>&1 | jq -Rs '{ok:true,details:.}' ;;
          peers)
              iface=$(printf '%s' "$input" | jq -r '.interface // ""')
              "$BIN" peers "$iface" || true ;;
          add_home|add_guest|disable_guest|enable_guest|delete_guest|guest_profile)
              name=$(printf '%s' "$input" | jq -r '.name // ""')
              case "$method" in
                  add_guest) action=add-guest ;;
                  add_home) action=add-home ;;
                  disable_guest) action=disable-guest ;;
                  enable_guest) action=enable-guest ;;
                  delete_guest) action=delete-guest ;;
                  guest_profile) action=guest-profile ;;
              esac
              "$BIN" "$action" "$name" || true ;;
          managed_profile|migrate_finish|migrate_cancel)
              iface=$(printf '%s' "$input" | jq -r '.interface // ""')
              name=$(printf '%s' "$input" | jq -r '.name // ""')
              case "$method" in
                  managed_profile) "$BIN" managed-profile "$iface" "$name" || true ;;
                  migrate_finish) "$BIN" migrate-finish "$iface" "$name" || true ;;
                  migrate_cancel) "$BIN" migrate-cancel "$iface" "$name" || true ;;
              esac ;;
          migrate_prepare)
              iface=$(printf '%s' "$input" | jq -r '.interface // ""')
              section=$(printf '%s' "$input" | jq -r '.section // ""')
              name=$(printf '%s' "$input" | jq -r '.name // ""')
              "$BIN" migrate-prepare "$iface" "$section" "$name" || true ;;
          *) echo '{"ok":false,"error":"Unsupported method"}' ;;
        esac
        ;;
    *) exit 1 ;;
esac
