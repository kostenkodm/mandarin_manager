#!/bin/sh
# Mandarin VPN Control Center, local backend. Requires root, jq, awg, UCI.
# No commands are executed through eval; interfaces and peer names are fixed/validated.
set -u

GUEST_IF=awg_guest
CLIENT_DIR=/etc/mandarin-vpn/clients/awg_guest
GUEST_ADDR_PREFIX=10.77.70

fail() {
    jq -nc --arg message "$1" '{ok:false,error:$message}'
    exit 1
}
json_ok() {
    jq -nc --arg message "$1" '{ok:true,message:$message}'
}
valid_name() {
    case "$1" in ''|*[!a-zA-Z0-9_-]*) return 1 ;; esac
    [ "${#1}" -le 32 ]
}
interface_exists() { ip link show dev "$1" >/dev/null 2>&1; }
uci_get() { uci -q get "$1" 2>/dev/null || true; }
if_protocol() { uci_get "network.$1.proto"; }

find_peer_section() {
    # Only peers created by this app are modifiable; existing peers remain untouched.
    name=$1
    valid_name "$name" || return 1
    section="mvpn_guest_${name}"
    [ "$(uci_get "network.$section")" = "amneziawg_awg_guest" ] || return 1
    printf '%s\n' "$section"
}

status() {
    tmp=$(mktemp -d) || fail 'Cannot create temporary directory'
    trap 'rm -rf "$tmp"' EXIT INT TERM
    for name in Prague vps2_reality Zurich wgkir_AWG awg_home awg_guest; do
        if [ "$name" = vps2_reality ]; then
            dev=''
            exists=false
        else
            dev=$name
            if interface_exists "$dev"; then exists=true; else exists=false; fi
        fi
        protocol=$(if_protocol "$name")
        if [ "$exists" = true ] && [ -n "$dev" ]; then
            if ip link show dev "$dev" | grep -q 'state UP\|<[^>]*UP'; then up=true; else up=false; fi
            if command -v awg >/dev/null 2>&1; then
                last=$(awg show "$dev" latest-handshakes 2>/dev/null | awk '$2 > x {x = $2} END {print x+0}')
                count=$(awg show "$dev" peers 2>/dev/null | awk 'NF{n++} END {print n+0}')
            else last=0; count=0; fi
        else up=false; last=0; count=0; fi
        if [ "$name" = awg_home ] || [ "$name" = awg_guest ]; then
            server_port=$(uci_get "network.$name.listen_port")
            if [ -n "$server_port" ]; then
                # An AWG interface with remote endpoint peers can be a client,
                # even if it has a local listen_port for NAT traversal.
                if uci -q show network | grep -E '^network\.[A-Za-z0-9_]+\.endpoint_host=' >/dev/null 2>&1; then
                    peer_kind="amneziawg_$name"
                    mode=server
                    for peer_section in $(uci -q show network | sed -n "s/^network\.\([A-Za-z0-9_]*\)=$peer_kind$/\1/p"); do
                        if [ -n "$(uci_get "network.$peer_section.endpoint_host")" ]; then
                            mode=client_tunnel
                            break
                        fi
                    done
                else
                    mode=server
                fi
            else
                mode=client_or_unconfigured
            fi
        else
            mode=outbound
            server_port=''
        fi
        jq -nc --arg name "$name" --arg proto "$protocol" --arg mode "$mode" --arg port "$server_port" --argjson present "$exists" --argjson up "$up" --argjson handshake "$last" --argjson peers "$count" \
           '{name:$name,protocol:$proto,present:$present,up:$up,mode:$mode,listen_port:$port,latest_handshake:$handshake,peer_count:$peers}' >> "$tmp/ifaces"
    done
    if [ -s /etc/sing-box/config.json ] && jq -e . /etc/sing-box/config.json >/dev/null 2>&1; then
        jq -c '[.outbounds[] | select(.tag == "main-out" or .tag == "prague_primary-out" or .tag == "vps2_reality-out" or .tag == "zurich_auto-out" or .tag == "wgkir_auto-out") | {tag,type,outbounds:(.outbounds // []),fallbacks:(.fallbacks // []),bind_interface:(.bind_interface // null)}]' /etc/sing-box/config.json > "$tmp/routes"
        jq -c '[.route.rule_set[]? | select(.type == "local") | .path // empty]' /etc/sing-box/config.json | jq -r '.[]' | while IFS= read -r path; do
            [ -f "$path" ] || printf '%s\n' "$path"
        done | jq -Rsc 'split("\n") | map(select(length>0))' > "$tmp/missing"
    else
        echo '[]' > "$tmp/routes"
        echo '["sing-box config missing or invalid"]' > "$tmp/missing"
    fi
    if pidof sing-box >/dev/null 2>&1; then running=true; else running=false; fi
    if [ -n "$(uci_get podkop.settings.source_network_interfaces | tr ' ' '\n' | grep -x awg_guest || true)" ]; then source=true; else source=false; fi
    jq -n --slurpfile interfaces "$tmp/ifaces" --slurpfile routes "$tmp/routes" --slurpfile missing "$tmp/missing" --argjson running "$running" --argjson guest_source "$source" \
      '{ok:true,interfaces:$interfaces, outbounds:$routes[0],missing_rulesets:$missing[0],singbox_running:$running,guest_podkop_source:$guest_source}'
}

peers() {
    interface=$1
    case "$interface" in awg_home|awg_guest) ;; *) fail 'Unknown interface' ;; esac
    tmp=$(mktemp) || fail 'Cannot create temporary file'
    trap 'rm -f "$tmp"' EXIT INT TERM
    # Parse UCI section metadata, not peer keys or private configuration.
    uci -q show network 2>/dev/null | sed -n "s/^network\.\([^=]*\)=amneziawg_${interface}$/\1/p" | while IFS= read -r s; do
        name=$(uci_get "network.$s.description")
        [ -n "$name" ] || name=$s
        pub=$(uci_get "network.$s.public_key")
        ips=$(uci_get "network.$s.allowed_ips")
        disabled=$(uci_get "network.$s.disabled")
        endpoint=$(uci_get "network.$s.endpoint_host")
        if [ -n "$endpoint" ]; then remote=true; else remote=false; fi
        [ "$disabled" = 1 ] && active=false || active=true
        hs=0; rx=0; tx=0
        if interface_exists "$interface" && command -v awg >/dev/null 2>&1 && [ -n "$pub" ]; then
            hs=$(awg show "$interface" latest-handshakes 2>/dev/null | awk -v k="$pub" '$1 == k {print $2+0; found=1} END {if(!found) print 0}')
            transfer=$(awg show "$interface" transfer 2>/dev/null | awk -v k="$pub" '$1 == k {print $2+0, $3+0}')
            set -- $transfer
            rx=${1:-0}; tx=${2:-0}
        fi
        case "$s" in mvpn_guest_*|mvpn_home_*) manageable=true ;; *) manageable=false ;; esac
        migration_from=$(uci_get "network.$s.mvpn_migration_from_interface")
        migration_section=$(uci_get "network.$s.mvpn_migration_from_section")
        jq -nc --arg section "$s" --arg name "$name" --arg ips "$ips" --arg key "$pub" --arg from "$migration_from" --arg fromsection "$migration_section" --argjson active "$active" --argjson hs "$hs" --argjson rx "$rx" --argjson tx "$tx" --argjson remote "$remote" --argjson manageable "$manageable" \
           '{section:$section,name:$name,allowed_ips:$ips,public_key:$key,enabled:$active,latest_handshake:$hs,rx_bytes:$rx,tx_bytes:$tx,has_endpoint:$remote,manageable:$manageable,migration_from:$from,migration_from_section:$fromsection}' 
    done > "$tmp"
    jq -s --arg interface "$interface" '{ok:true,interface:$interface,peers:.}' < "$tmp"
}

server_ready() {
    [ "$(if_protocol "$GUEST_IF")" = amneziawg ] || fail 'Guest server is not configured; run guest-prepare first'
    interface_exists "$GUEST_IF" || fail 'Guest interface is not running; activate configuration first'
    command -v awg >/dev/null 2>&1 || fail 'awg command missing'
}

free_guest_ip() {
    for n in $(seq 2 254); do
        addr="$GUEST_ADDR_PREFIX.$n"
        if ! uci -q show network | grep -Fq "='$addr/32'" && ! uci -q show network | grep -Fq "='$addr'"; then
            printf '%s\n' "$addr"
            return 0
        fi
    done
    return 1
}

client_profile() {
    file=$1
    [ -r "$file" ] || fail 'Client profile is missing'
    jq -n --rawfile profile "$file" '{ok:true,profile:$profile}'
}

add_guest() {
    name=$1
    valid_name "$name" || fail 'Name must contain only A-Z, a-z, 0-9, underscore, hyphen (1..32 characters)'
    server_ready
    section="mvpn_guest_$name"
    [ -z "$(uci_get "network.$section")" ] || fail 'A client with this name already exists'
    [ ! -e "$CLIENT_DIR/$name.conf" ] || fail 'A profile file already exists'
    endpoint=$(uci_get mandarin_vpn.settings.endpoint)
    port=$(uci_get network.awg_guest.listen_port)
    [ -n "$endpoint" ] || fail 'External endpoint is not configured'
    [ -n "$port" ] || fail 'Guest listen port missing'
    ip4=$(free_guest_ip) || fail 'No available guest IP'
    server_private=$(uci_get network.awg_guest.private_key)
    [ -n "$server_private" ] || fail 'Server private key is missing'
    server_public=$(printf '%s\n' "$server_private" | awg pubkey 2>/dev/null) || fail 'Failed to derive server public key'
    client_private=$(awg genkey) || fail 'Failed to generate client key'
    client_public=$(printf '%s\n' "$client_private" | awg pubkey 2>/dev/null) || fail 'Failed to derive client public key'
    psk=$(awg genpsk) || fail 'Failed to generate preshared key'
    umask 077
    mkdir -p "$CLIENT_DIR" || fail 'Failed to create client directory'
    profile="$CLIENT_DIR/$name.conf"
    {
        echo '[Interface]'
        echo "PrivateKey = $client_private"
        echo "Address = $ip4/32"
        echo "DNS = $GUEST_ADDR_PREFIX.1"
        for prop in jc jmin jmax s1 s2 h1 h2 h3 h4; do
            key="awg_$prop"
            value=$(uci_get "network.awg_guest.$key")
            if [ -n "$value" ]; then
                case "$prop" in jc) out=Jc ;; jmin) out=Jmin ;; jmax) out=Jmax ;; *) out=$(printf '%s' "$prop" | tr '[:lower:]' '[:upper:]') ;; esac
                echo "$out = $value"
            fi
        done
        echo
        echo '[Peer]'
        echo "PublicKey = $server_public"
        echo "PresharedKey = $psk"
        echo "Endpoint = $endpoint:$port"
        echo 'AllowedIPs = 0.0.0.0/0'
        echo 'PersistentKeepalive = 25'
    } > "$profile" || fail 'Unable to write profile'
    chmod 600 "$profile"
    uci set "network.$section=amneziawg_awg_guest"
    uci set "network.$section.description=$name"
    uci set "network.$section.public_key=$client_public"
    uci set "network.$section.preshared_key=$psk"
    uci add_list "network.$section.allowed_ips=$ip4/32"
    uci set "network.$section.route_allowed_ips=0"
    uci commit network || { rm -f "$profile"; fail 'Failed to save UCI peer'; }
    pskfile=$(mktemp) || fail 'Failed to create temporary preshared-key file'
    chmod 600 "$pskfile"
    printf '%s\n' "$psk" > "$pskfile"
    if ! awg set "$GUEST_IF" peer "$client_public" preshared-key "$pskfile" allowed-ips "$ip4/32" 2>/dev/null; then
        rm -f "$pskfile" "$profile"
        uci -q delete "network.$section"
        uci commit network
        fail 'Runtime peer update failed; configuration rolled back'
    fi
    rm -f "$pskfile"
    logger -t mandarin-vpn "created guest peer $name ($ip4)"
    client_profile "$profile"
}

set_guest() {
    name=$1; enabled=$2
    section=$(find_peer_section "$name") || fail 'Managed guest client not found'
    pub=$(uci_get "network.$section.public_key")
    ips=$(uci_get "network.$section.allowed_ips")
    psk=$(uci_get "network.$section.preshared_key")
    case "$enabled" in
        0)
            uci set "network.$section.disabled=1"
            uci commit network
            if interface_exists "$GUEST_IF"; then awg set "$GUEST_IF" peer "$pub" remove || fail 'Failed to disable runtime peer'; fi
            json_ok 'Guest client disabled'
        ;;
        1)
            [ -n "$pub" ] && [ -n "$psk" ] && [ -n "$ips" ] || fail 'Peer data incomplete'
            server_ready
            keyfile=$(mktemp) || fail 'Cannot create key file'
            chmod 600 "$keyfile"
            printf '%s\n' "$psk" > "$keyfile"
            if ! awg set "$GUEST_IF" peer "$pub" preshared-key "$keyfile" allowed-ips "$ips"; then
                rm -f "$keyfile"
                fail 'Failed to enable peer'
            fi
            rm -f "$keyfile"
            uci -q delete "network.$section.disabled" || true
            uci commit network
            json_ok 'Guest client enabled'
        ;;
        *) fail 'Invalid state' ;;
    esac
}

delete_guest() {
    name=$1
    section=$(find_peer_section "$name") || fail 'Managed guest client not found'
    pub=$(uci_get "network.$section.public_key")
    if interface_exists "$GUEST_IF" && [ -n "$pub" ]; then
        awg set "$GUEST_IF" peer "$pub" remove || fail 'Failed to revoke runtime peer'
    fi
    uci delete "network.$section"
    uci commit network
    rm -f "$CLIENT_DIR/$name.conf"
    logger -t mandarin-vpn "revoked guest peer $name"
    json_ok 'Guest client permanently revoked'
}

get_guest_profile() {
    name=$1
    section=$(find_peer_section "$name") || fail 'Managed guest client not found'
    client_profile "$CLIENT_DIR/$name.conf"
}



# v0.3: New Home clients are created on the existing server without
# altering other peers, firewall rules, Podkop or the AWG interface itself.
# Home must have a /24 IPv4 address: otherwise refuse instead of guessing.
add_home() {
    name=$1
    valid_name "$name" || fail 'Client name must contain only A-Z, a-z, 0-9, _ or - (1..32)'
    [ "$(if_protocol awg_home)" = amneziawg ] || fail 'Home AWG interface is not configured'
    interface_exists awg_home || fail 'Home AWG interface is not running'
    [ -n "$(uci_get network.awg_home.listen_port)" ] || fail 'Home listen port missing'
    section="mvpn_home_$name"
    [ -z "$(uci_get "network.$section")" ] || fail 'Client name already exists on Home'
    dir=/etc/mandarin-vpn/clients/awg_home
    profile="$dir/$name.conf"
    [ ! -e "$profile" ] || fail 'A saved Home profile already exists'
    ip4=$(free_ip_for awg_home) || fail 'Home IPv4 /24 or free address missing. Check the Home interface address.'
    # Do not modify an existing Home pool or assign an address blindly.
    client_private=$(awg genkey) || fail 'Cannot generate Home client key'
    client_public=$(printf '%s\n' "$client_private" | awg pubkey 2>/dev/null) || fail 'Cannot derive Home client public key'
    psk=$(awg genpsk) || fail 'Cannot generate Home PSK'
    network_backup
    umask 077
    mkdir -p "$dir" || fail 'Cannot create Home profile directory'
    create_profile_for awg_home "$profile" "$client_private" "$psk" "$ip4"
    uci set "network.$section=amneziawg_awg_home"
    uci set "network.$section.description=$name"
    uci set "network.$section.public_key=$client_public"
    uci set "network.$section.preshared_key=$psk"
    uci add_list "network.$section.allowed_ips=$ip4/32"
    uci set "network.$section.route_allowed_ips=0"
    if ! uci commit network; then
        rm -f "$profile"
        uci -q delete "network.$section" || true
        fail 'Failed to save Home peer'
    fi
    pskfile=$(mktemp) || fail 'Cannot create temporary PSK file'
    chmod 600 "$pskfile"
    printf '%s\n' "$psk" > "$pskfile"
    if ! awg set awg_home peer "$client_public" preshared-key "$pskfile" allowed-ips "$ip4/32" 2>/dev/null; then
        rm -f "$pskfile" "$profile"
        uci -q delete "network.$section" || true
        uci commit network
        fail 'Runtime Home peer update failed; new peer rolled back'
    fi
    rm -f "$pskfile"
    logger -t mandarin-vpn "created Home peer $name ($ip4)"
    client_profile "$profile"
}


# v0.2: peer migration is staged, never removes old peer before confirmed
# handshake on the destination interface. Existing Home private keys are
# not recoverable, so every migration produces a NEW client configuration.
managed_section() {
    iface=$1
    client=$2
    valid_name "$client" || return 1
    case "$iface" in
        awg_home) section="mvpn_home_$client" ;;
        awg_guest) section="mvpn_guest_$client" ;;
        *) return 1 ;;
    esac
    [ "$(uci_get "network.$section")" = "amneziawg_$iface" ] || return 1
    printf '%s\n' "$section"
}

validate_section() {
    src_iface=$1
    src_section=$2
    case "$src_iface" in awg_home|awg_guest) ;; *) fail 'Unknown source interface' ;; esac
    case "$src_section" in
        @amneziawg_awg_home\[*\]|@amneziawg_awg_guest\[*\]|mvpn_guest_*|mvpn_home_*|[a-zA-Z0-9_]*) ;;
        *) fail 'Invalid section identifier' ;;
    esac
    [ "$(uci_get "network.$src_section")" = "amneziawg_$src_iface" ] || fail 'Source peer not found on this interface'
}

network_backup() {
    umask 077
    mkdir -p /root/mandarin-vpn-backups || fail 'Cannot create backup directory'
    bfile="/root/mandarin-vpn-backups/network-$(date +%Y%m%d-%H%M%S)-$$.bak"
    cp -p /etc/config/network "$bfile" || fail 'Cannot back up UCI network'
    chmod 600 "$bfile"
}

# Require the server interface to have an IPv4 address in a /24 network.
# Refuse to guess a pool for other masks.
server_ipv4() {
    target=$1
    ip -4 -o addr show dev "$target" 2>/dev/null | awk '$3 == "inet" {print $4;exit}'
}

free_ip_for() {
    target=$1
    addr=$(server_ipv4 "$target")
    case "$addr" in
        *.*.*.*/24) ;; *) fail 'Target server must have an IPv4 /24 address for managed clients' ;;
    esac
    prefix=${addr%.*}
    for n in $(seq 2 254); do
        candidate="$prefix.$n"
        [ "$candidate" = "${addr%/*}" ] && continue
        # Check all stored peers, including disabled ones, before allocating.
        if uci -q show network | grep -Fq "='$candidate/32'" ||
           uci -q show network | grep -Fq "='$candidate'" ||
           (awg show "$target" allowed-ips 2>/dev/null | grep -Fq "$candidate/32"); then
            continue
        fi
        printf '%s\n' "$candidate"
        return 0
    done
    return 1
}

create_profile_for() {
    target=$1; profile=$2; client_private=$3; psk=$4; ip4=$5
    port=$(uci_get "network.$target.listen_port")
    server_private=$(uci_get "network.$target.private_key")
    [ -n "$port" ] && [ -n "$server_private" ] || fail 'Target server key or port missing'
    endpoint=$(uci_get "mandarin_vpn.settings.${target}_endpoint")
    [ -n "$endpoint" ] || endpoint=$(uci_get mandarin_vpn.settings.endpoint)
    [ -n "$endpoint" ] || fail 'Set external endpoint in mandarin_vpn.settings.endpoint'
    pub=$(printf '%s\n' "$server_private" | awg pubkey 2>/dev/null) || fail 'Cannot derive target server public key'
    serverip=$(server_ipv4 "$target")
    serverip=${serverip%/*}
    {
        printf '[Interface]\nPrivateKey = %s\nAddress = %s/32\nDNS = %s\n' "$client_private" "$ip4" "$serverip"
        for prop in jc jmin jmax s1 s2 h1 h2 h3 h4; do
            value=$(uci_get "network.$target.awg_$prop")
            [ -n "$value" ] || value=$(uci_get "network.$target.$prop")
            [ -n "$value" ] || continue
            case "$prop" in jc) out=Jc ;; jmin) out=Jmin ;; jmax) out=Jmax ;; *) out=$(printf '%s' "$prop" | tr '[:lower:]' '[:upper:]') ;; esac
            printf '%s = %s\n' "$out" "$value"
        done
        printf '\n[Peer]\nPublicKey = %s\nPresharedKey = %s\nEndpoint = %s:%s\nAllowedIPs = 0.0.0.0/0\nPersistentKeepalive = 25\n' "$pub" "$psk" "$endpoint" "$port"
    } > "$profile" || fail 'Cannot write client profile'
    chmod 600 "$profile"
}

prepare_migration() {
    source_if=$1; source_sec=$2; name=$3
    validate_section "$source_if" "$source_sec"
    valid_name "$name" || fail 'New name must contain A-Z, a-z, 0-9, _ or - (up to 32)'
    [ "$(uci_get "network.$source_sec.disabled")" != 1 ] || fail 'Source peer is disabled'
    [ -z "$(uci_get "network.$source_sec.endpoint_host")" ] || fail 'Cannot migrate an outbound client tunnel'
    source_key=$(uci_get "network.$source_sec.public_key")
    [ -n "$source_key" ] || fail 'Source peer public key missing'
    # A peer cannot be staged for two migrations concurrently.
    if uci -q show network | grep 'mvpn_migration_from_section=' | grep -Fq "='$source_sec'"; then
        fail 'Migration is already staged for this source client'
    fi
    case "$source_if" in
        awg_home) target=awg_guest; prefix=mvpn_guest ;;
        awg_guest) target=awg_home; prefix=mvpn_home ;;
    esac
    target_sec="${prefix}_${name}"
    [ -z "$(uci_get "network.$target_sec")" ] || fail 'Target peer name already exists'
    server_protocol=$(if_protocol "$target")
    [ "$server_protocol" = 'amneziawg' ] || fail 'Target AWG server is not configured'
    interface_exists "$source_if" || fail 'Source AWG interface is not running'
    interface_exists "$target" || fail 'Target AWG interface is not running'
    command -v awg >/dev/null 2>&1 || fail 'Missing awg utility'
    ip4=$(free_ip_for "$target") || fail 'No free IP on target server'
    dir="/etc/mandarin-vpn/clients/$target"
    profile="$dir/$name.conf"
    [ ! -e "$profile" ] || fail 'Target client profile already exists'
    network_backup
    umask 077
    mkdir -p "$dir" || fail 'Cannot create profile directory'
    client_private=$(awg genkey) || fail 'Unable to generate client key'
    client_public=$(printf '%s\n' "$client_private" | awg pubkey 2>/dev/null) || fail 'Unable to derive client public key'
    psk=$(awg genpsk) || fail 'Unable to generate preshared key'
    create_profile_for "$target" "$profile" "$client_private" "$psk" "$ip4"
    uci set "network.$target_sec=amneziawg_$target"
    uci set "network.$target_sec.description=$name"
    uci set "network.$target_sec.public_key=$client_public"
    uci set "network.$target_sec.preshared_key=$psk"
    uci add_list "network.$target_sec.allowed_ips=$ip4/32"
    uci set "network.$target_sec.route_allowed_ips=0"
    uci set "network.$target_sec.mvpn_migration_from_interface=$source_if"
    uci set "network.$target_sec.mvpn_migration_from_section=$source_sec"
    uci set "network.$target_sec.mvpn_migration_started=$(date +%s)"
    if ! uci commit network; then
        rm -f "$profile"
        fail 'Failed to commit target UCI peer'
    fi
    pskfile=$(mktemp) || fail 'Cannot create temporary PSK file'
    chmod 600 "$pskfile"
    printf '%s\n' "$psk" > "$pskfile"
    if ! awg set "$target" peer "$client_public" preshared-key "$pskfile" allowed-ips "$ip4/32" 2>/dev/null; then
        rm -f "$pskfile" "$profile"
        uci -q delete "network.$target_sec" || true
        uci commit network
        fail 'Unable to install staged peer; target rolled back'
    fi
    rm -f "$pskfile"
    logger -t mandarin-vpn "staged migration ${source_if} -> ${target}, name=${name}, ip=${ip4}"
    jq -n --rawfile profile "$profile" --arg source "$source_if" --arg target "$target" --arg name "$name" --arg ip "$ip4" \
       '{ok:true,state:"staged",source:$source,target:$target,name:$name,ip:$ip,profile:$profile,message:"Import the NEW profile and connect. Finish migration only after handshake."}'
}

migration_section() {
    dest=$1; client=$2
    resolved_section=$(managed_section "$dest" "$client") || fail 'Managed target client missing'
    from=$(uci_get "network.$resolved_section.mvpn_migration_from_interface")
    oldsection=$(uci_get "network.$resolved_section.mvpn_migration_from_section")
    [ -n "$from" ] && [ -n "$oldsection" ] || fail 'No staged migration for this client'
    validate_section "$from" "$oldsection"
}

finish_migration() {
    dest=$1; client=$2
    migration_section "$dest" "$client"
    section=$resolved_section
    newkey=$(uci_get "network.$section.public_key")
    started=$(uci_get "network.$section.mvpn_migration_started")
    [ -n "$newkey" ] && [ -n "$started" ] || fail 'Target migration metadata incomplete'
    interface_exists "$dest" || fail 'Target interface is down'
    handshake=$(awg show "$dest" latest-handshakes 2>/dev/null | awk -v k="$newkey" '$1==k {print $2+0; found=1} END {if(!found) print 0}')
    if [ "$handshake" -eq 0 ] || [ "$handshake" -lt "$started" ]; then
        fail 'Target has not completed a fresh AWG handshake. Import the new QR/profile and connect first.'
    fi
    oldkey=$(uci_get "network.$oldsection.public_key")
    [ -n "$oldkey" ] || fail 'Old peer public key missing'
    interface_exists "$from" || fail 'Old interface is not running; cannot safely finalize'
    network_backup
    awg set "$from" peer "$oldkey" remove 2>/dev/null || fail 'Unable to disable old runtime peer'
    uci set "network.$oldsection.disabled=1"
    uci -q delete "network.$section.mvpn_migration_from_interface" || true
    uci -q delete "network.$section.mvpn_migration_from_section" || true
    uci -q delete "network.$section.mvpn_migration_started" || true
    uci commit network || fail 'Failed to save new peer state; restore from backup'
    logger -t mandarin-vpn "completed migration $from -> $dest: $client; old peer disabled"
    json_ok 'Migration completed. Old peer is disabled and preserved in UCI for rollback.'
}

cancel_migration() {
    dest=$1; client=$2
    migration_section "$dest" "$client"
    section=$resolved_section
    newkey=$(uci_get "network.$section.public_key")
    [ -n "$newkey" ] || fail 'Target public key missing'
    network_backup
    if interface_exists "$dest"; then
        awg set "$dest" peer "$newkey" remove 2>/dev/null || fail 'Unable to remove staged runtime peer'
    fi
    uci delete "network.$section" || fail 'Unable to delete staged target'
    uci commit network || fail 'Unable to save canceled migration'
    rm -f "/etc/mandarin-vpn/clients/$dest/$client.conf"
    logger -t mandarin-vpn "canceled migration $dest/$client"
    json_ok 'Staged target removed; original client remains connected.'
}

get_managed_profile() {
    iface=$1; client=$2
    managed_section "$iface" "$client" >/dev/null || fail 'Managed client not found'
    client_profile "/etc/mandarin-vpn/clients/$iface/$client.conf"
}

case "${1:-}" in
    status) status ;;
    peers) peers "${2:-}" ;;
    add-guest) add_guest "${2:-}" ;;
    add-home) add_home "${2:-}" ;;
    disable-guest) set_guest "${2:-}" 0 ;;
    enable-guest) set_guest "${2:-}" 1 ;;
    delete-guest) delete_guest "${2:-}" ;;
    guest-profile) get_guest_profile "${2:-}" ;;
    managed-profile) get_managed_profile "${2:-}" "${3:-}" ;;
    migrate-prepare) prepare_migration "${2:-}" "${3:-}" "${4:-}" ;;
    migrate-finish) finish_migration "${2:-}" "${3:-}" ;;
    migrate-cancel) cancel_migration "${2:-}" "${3:-}" ;;
    *) fail 'Usage: mandarin-vpn status|peers IFACE|add-guest NAME|disable-guest NAME|enable-guest NAME|delete-guest NAME|guest-profile NAME' ;;
esac
