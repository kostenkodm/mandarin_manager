#!/bin/sh
# Read-only diagnostic for inbound AWG Guest. Does not print peer public/private keys.
set -u
printf '=== Guest IPv4 ===\n'
ip -4 -br addr show dev awg_guest 2>&1 || true
printf '\n=== Guest peer traffic (bytes, no keys) ===\n'
if command -v awg >/dev/null 2>&1; then
    awg show awg_guest transfer 2>/dev/null | awk '{printf "client_%d rx=%s tx=%s\n", NR, $2, $3}'
    printf 'listen_port: '
    awg show awg_guest listen-port 2>/dev/null || true
fi
printf '\n=== Guest firewall configuration ===\n'
for sec in mvpn_guest_zone mvpn_guest_wan mvpn_guest_dns mvpn_guest_in; do
    uci -q show "firewall.$sec" || true
done
printf '\n=== WAN zone masquerading ===\n'
uci -q show firewall | grep -E "^firewall\.[^.]+\.(name|masq)=" | grep -E "wan|masq" || true
printf '\n=== DNS listeners ===\n'
ss -lnut 2>/dev/null | grep -E '(:53[[:space:]]|:53$)' | head -n 12 || true
printf '\n=== DNS interface restriction (if configured) ===\n'
uci -q show dhcp | grep -E '(^dhcp\.[^.]+\.(interface|notinterface|nonwildcard|localservice|port)=)' | head -n 30 || true
printf '\n=== Routing from typical Guest client ===\n'
ip -4 route get 1.1.1.1 from 10.77.70.2 iif awg_guest 2>&1 || true
printf '\n=== Podkop source interfaces ===\n'
uci -q get podkop.settings.source_network_interfaces || true
printf '\n=== Sing-box TPROXY input (ports only) ===\n'
if [ -r /etc/sing-box/config.json ]; then
    jq -r '.inbounds[]? | select(.type == "tproxy" or .type == "redirect" or .type == "tun") | [.tag,.type,(.listen_port // "-")] | @tsv' /etc/sing-box/config.json 2>/dev/null || true
fi
printf '\n=== Firewall active state (selected rules, no secrets) ===\n'
nft list ruleset 2>/dev/null | grep -Ei 'mvpn_guest|awg_guest|podkop' | head -n 40 || true
printf '\n=== Processes ===\n'
pgrep -af sing-box || true
